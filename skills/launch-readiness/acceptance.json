{
  "skill": "launch-readiness",
  "cases": [
    {
      "id": "normal",
      "prompt": "我的店 allbirds.com 下个月要在美国和英国投谷歌购物广告, 帮我做一次上线前体检, 看看政策页和多市场设置有什么要改的",
      "lang": "zh",
      "needs_network": true,
      "expect": {
        "deliverables": [
          "*.pdf|*.html",
          "*.csv"
        ],
        "status_in": [
          "complete",
          "partial"
        ],
        "must_not_contain": [
          "products.json",
          "myshopify",
          "已合规",
          "不合规"
        ],
        "must_contain_any": [
          "[已核实]"
        ],
        "fixed_ending": true,
        "status_by_runner": {
          "codex-nonet": [
            "failed",
            "partial"
          ]
        },
        "expect_by_runner": {
          "codex-nonet": {
            "deliverables": [
              "*.pdf|*.html"
            ],
            "must_contain_any": [
              "[查不到]"
            ]
          }
        }
      }
    },
    {
      "id": "paste-conflicts",
      "prompt": "店还没上线 (开着密码), 我把退货政策, 运费政策, 常见问题和商品导出都放在技能目录下的 tests/fixtures/F3-paste/ 文件夹里了, 卖欧盟和澳洲, 帮我查查哪里写得不对",
      "lang": "zh",
      "needs_network": false,
      "expect": {
        "deliverables": [
          "*.pdf|*.html",
          "*.csv"
        ],
        "status_in": [
          "partial"
        ],
        "must_not_contain": [
          "products.json",
          "myshopify",
          "已合规",
          "不合规"
        ],
        "must_contain_any": [
          "[店铺自称]",
          "[有矛盾]"
        ],
        "fixed_ending": true
      }
    },
    {
      "id": "non-shopify-or-locked",
      "prompt": "Please run a launch readiness check on example.com, it's my new store (not on Shopify) selling to Germany",
      "lang": "en",
      "needs_network": true,
      "expect": {
        "deliverables": [
          "*.pdf|*.html"
        ],
        "status_in": [
          "partial",
          "failed"
        ],
        "must_not_contain": [
          "products.json",
          "myshopify",
          "compliant"
        ],
        "must_contain_any": [
          "[Not found]"
        ],
        "fixed_ending": true,
        "expect_by_runner": {
          "codex-nonet": {
            "status_in": [
              "partial",
              "failed"
            ]
          }
        }
      }
    }
  ],
  "fixed_ending_text": {
    "zh": "本报告没有覆盖的",
    "en": "What this report does not cover"
  },
  "network_domains": [
    "www.allbirds.com"
  ],
  "script_steps": [
    {
      "argv": [
        "{python}",
        "-c",
        "import ast, glob, sys; [ast.parse(open(p, encoding='utf-8').read(), p) for p in sorted(glob.glob(sys.argv[1] + '/scripts/*.py'))]",
        "{skill_dir}"
      ]
    },
    {
      "argv": [
        "{python}",
        "{skill_dir}/scripts/audit_collect.py",
        "{domain}",
        "--markets",
        "US,UK",
        "--out-root",
        "{out_root}"
      ],
      "when": "domain"
    }
  ]
}
